# omul — the environment a deployment supplies.
#
#     cp .env.example .env
#
# then fill in BETTER_AUTH_SECRET below. `docker compose up -d` reads that copy
# (compose.yaml names it as its env_file) and hands every line to the container.
# .env is git-ignored; this file is not, which is why nothing below ships with a
# working secret, a working credential or anybody's address in it. A placeholder
# that worked here would work in every clone of this repository.
#
# docs/deployment.md is the full reference — every variable the server reads and
# what breaks when it is unset. What follows is the subset a deployment has to
# make a decision about.


# ── Required ──────────────────────────────────────────────────────────────

# The secret every session cookie is signed with. The server refuses to start
# without it: there is no fallback and no default, because a placeholder
# shipping in public source would let anyone who has read that source mint a
# session for any account, administrators included. It also refuses a value
# under 32 characters, and refuses this application's own development literal if
# you paste that in here instead.
#
# Generate one and put the output on the line below, unquoted. Do not reuse it
# across deployments; changing it later signs every existing session out.
#
#     openssl rand -base64 32
#
BETTER_AUTH_SECRET=


# ── Serving it to anyone but yourself ─────────────────────────────────────
#
# Both stay unset for compose.yaml's default — a container published on
# 127.0.0.1:3000 and reached at http://localhost:3000 from the machine it runs
# on. Set both the moment a reverse proxy and a public name are in front of it.

# The public host, as a bare host: no scheme, no path, no trailing slash, read
# as https://. Behind a proxy this is required for sign-in to work at all — it
# is what puts the public origin on the list of origins allowed to drive auth —
# and it is also what puts a reachable link in verification and password-reset
# mail, and what the /api discovery index advertises. A value carrying a scheme
# or a path is a fatal startup error rather than a silently ignored one.
#OMUL_BASE_HOST=omul.example.com

# How many reverse-proxy hops in front of the server may be believed when it
# reads X-Forwarded-For to tell one visitor from another. "true" is 1 and is
# right for a single reverse proxy; a CDN in front of that proxy makes it 2.
# Unset (0) means forwarded headers are ignored entirely, which is correct — and
# required — for a directly exposed container, and wrong behind a proxy: there
# every visitor on the internet shares the proxy's single rate-limit bucket, a
# ceiling a 300-person room reaches in two slide reveals.
#OMUL_TRUST_PROXY=true


# ── The admin surface, which ships with nobody on it ──────────────────────

# Comma-separated sign-in addresses of the accounts allowed to use /api/admin/*,
# matched case-insensitively and read once at startup. Empty is the default and
# means nobody is an administrator: every admin route answers 403, yours
# included. That is a complete instance — nothing a presenter or a participant
# does goes through the admin surface — so name someone only if you want one.
# It ships empty for the same reason the signing secret ships absent: a list
# here would name one deployment's administrators in every deployment built from
# this source.
#
# The address has to belong to an account that has signed up; there is no
# self-service grant. Which posture is in force is printed on every boot, so a
# restart confirms the list landed.
OMUL_ADMIN_EMAILS=


# ── State ─────────────────────────────────────────────────────────────────

# Where the SQLite files live. The image already sets this to
# /app/data/omul.sqlite and compose.yaml mounts a volume at /app/data, so there
# is nothing to do here — it is spelled out because the sibling rule is the one
# way to lose data while mounting storage that looks right.
#
# auth.sqlite (accounts and sessions) and admin.sqlite (the admin event log)
# resolve as siblings of this path, so all three databases live in its
# directory. Mount the directory, not the file: a volume mounted at
# /app/data/omul.sqlite persists one database of the three and silently drops
# the other two, every account among them.
#DATABASE_PATH=/app/data/omul.sqlite

# PORT is set to 3000 by the image, and compose.yaml maps it. To serve the
# instance on a different port of your host, change the left-hand side of that
# mapping rather than setting anything here.


# ── Optional: outgoing mail ───────────────────────────────────────────────
#
# Unset, nothing is sent and the message is written to the container log
# instead, links and all — which is enough to run an instance, because email
# verification is not a gate: an account can sign in and use every feature the
# moment it signs up. Sending needs all three of SEND_EMAILS="true", an API key
# and a sender address; short of that the emailer stays in log mode and says
# which one is missing.

#SEND_EMAILS=true
#BREVO_API_KEY=
#BREVO_SENDER_EMAIL=omul@example.com
#BREVO_SENDER_NAME=omul
# Where replies go, when that should not be the sender address.
#BREVO_REPLY_TO_EMAIL=
#BREVO_REPLY_TO_NAME=


# ── Optional: drafting a deck from a prompt ───────────────────────────────
#
# The one part of omul that talks to anything outside this deployment: it sends
# the prompt, and only the prompt, to a model provider. Unset is the default and
# means off — nothing else in the product changes, and every other way to start
# a deck is unaffected. Read README.md and docs/deployment.md before turning it
# on; the request leaves your network and it spends your provider budget.

#GOOGLE_GENERATIVE_AI_API_KEY=
#OMUL_GENERATION_MODEL=gemini-flash-latest
# Exactly "true" lets callers with no account spend that credential. The default
# requires a signed-in account, and it is deliberately independent of the abuse
# limits below — switching those off must not hand you an open LLM proxy.
#OMUL_GENERATION_ALLOW_ANONYMOUS=true


# ── Optional: abuse limits ────────────────────────────────────────────────

# On by default: 30 creates per 5 minutes and 600 joins or public writes per
# minute per client, 60 per minute per participant. Exactly "true" switches them
# off, which is for a self-hoster on a trusted network and nothing else — it
# takes the deck-generation budget off with them. Anything other than "true"
# leaves them on, so a typo cannot silently disarm the protection.
#OMUL_RATE_LIMITS_DISABLED=true

# Extra comma-separated origins allowed to drive auth, beyond the one
# OMUL_BASE_HOST adds.
#OMUL_TRUSTED_ORIGINS=
